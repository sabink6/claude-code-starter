rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['id', 'codename'])
        && request.resource.data.id == uid
        && request.resource.data.codename is string
        && request.resource.data.codename.size() > 0;

      allow update, delete: if false;
    }

    match /heists/{heistId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.assignedTo != request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.deadline is timestamp
        && request.resource.data.successClaimedAt == null
        && request.resource.data.finalStatus == null
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 500
        && request.resource.data.createdByCodename is string
        && request.resource.data.createdByCodename.size() > 0
        && request.resource.data.assignedToCodename is string
        && request.resource.data.assignedToCodename.size() > 0
        && request.resource.data.keys().hasOnly([
          'createdAt', 'title', 'description', 'createdBy', 'createdByCodename',
          'assignedTo', 'assignedToCodename', 'deadline', 'successClaimedAt', 'finalStatus',
        ]);

      // Claim: assignee marks an open heist as successfully done.
      allow update: if request.auth != null
        && request.auth.uid == resource.data.assignedTo
        && resource.data.successClaimedAt == null
        && resource.data.finalStatus == null
        && request.resource.data.diff(resource.data).affectedKeys() == ['successClaimedAt'].toSet()
        && request.resource.data.successClaimedAt == request.time;

      // Confirm: creator accepts a pending claim.
      allow update: if request.auth != null
        && request.auth.uid == resource.data.createdBy
        && resource.data.successClaimedAt != null
        && resource.data.finalStatus == null
        && request.resource.data.diff(resource.data).affectedKeys() == ['finalStatus'].toSet()
        && request.resource.data.finalStatus == 'success';

      // Reject: creator rejects a pending claim, resetting it back to open.
      allow update: if request.auth != null
        && request.auth.uid == resource.data.createdBy
        && resource.data.successClaimedAt != null
        && resource.data.finalStatus == null
        && request.resource.data.diff(resource.data).affectedKeys() == ['successClaimedAt', 'finalStatus'].toSet()
        && request.resource.data.successClaimedAt == null
        && request.resource.data.finalStatus == null;

      allow delete: if false;
    }
  }
}
